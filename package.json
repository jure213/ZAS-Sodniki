{
  "name": "zas-sodniki",
  "version": "1.1.2",
  "description": "Athletic Officials Payment Tracker",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Jure Rus",
    "email": "jure.rus04@gmail.com"
  },
  "scripts": {
    "generate:config": "node scripts/generate-api-config.js",
    "dev": "npm run tsc && electron .",
    "tsc": "npm run generate:config && node scripts/copy-vendor.js && tsc -p tsconfig.json",
    "start": "npm run dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "npm run tsc && electron-builder",
    "build:linux": "npm run tsc && electron-builder --linux",
    "build:win": "npm run tsc && electron-builder --win"
  },
  "keywords": [
    "electron",
    "postgrest",
    "athletics",
    "payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/postgrest-js": "^2.78.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^3.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.zas.sodniki",
    "productName": "ZAS Sodniki",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "src/**/*"
    ],
    "icon": "electron/zas_ikona.ico",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "ZAS <info@zas.si>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "ZAS.Sodniki.Setup.${version}.${ext}",
      "signAndEditExecutable": false
    }
  },
  "repository": "https://github.com/jure213/ZAS-Sodniki",
  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
